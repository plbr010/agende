NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only runtime origin for callbacks and CSRF; public origin is baked
# into browser assets. Use the actual origin of the isolated server/deployment.
# SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_. Required for /api/account/avatar;
# other account mutations use the user session + RPCs. Must belong to the same
# Supabase project as NEXT_PUBLIC_SUPABASE_URL. Separate Preview and production.
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only allowlist to provision the first /admin master. Comma-separated.
# The matching confirmed user claims access; the grant is stored in app.platform_admins,
# not in the editable profile. Requires SUPABASE_SERVICE_ROLE_KEY or a SQL grant:
#   select public.grant_platform_admin('<user-uuid>');
# AGENDE_MASTER_ADMIN_EMAILS=
