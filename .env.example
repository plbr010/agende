NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only runtime origin for callbacks and CSRF; public origin is baked
# into browser assets. Use the actual origin of the isolated server/deployment.
# SITE_URL=http://localhost:3000

# Server-only. Never prefix with NEXT_PUBLIC_. Required for /api/account/avatar;
# other account mutations use the user session + RPCs. Must belong to the same
# Supabase project as NEXT_PUBLIC_SUPABASE_URL. Separate Preview and production.
# SUPABASE_SERVICE_ROLE_KEY=

# Master admin is bound in SQL to the confirmed Auth user plbrpc@gmail.com
# (auth.users.id). Do not add other emails here; extra accounts cannot self-promote.
